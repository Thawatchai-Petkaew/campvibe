# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (e2e/ specs + committed snapshots ARE tracked; generated output is not)
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# CAM-359 — e2e-regression storageState (real session cookies; never commit)
/e2e/regression/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!env.example
# CAM-578 — placeholder-only template for the local e2e-regression harness; never a real secret
!.env.e2e.example

# sqlite (local dev artifacts / accidental files)
*.db
*.db-journal
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# claude code — personal settings (not shared)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# delivery-ticket schema (CAM-277 / ADR-010) — generated client only; the schema + future
# prisma/delivery/migrations/ ARE tracked
/prisma/delivery/generated/

# local uploads
/public/uploads*

# utility scripts (local) — but track the ticket-sync CLI used by CI + hooks
/scripts/*
!/scripts/ticket-sync.mjs
!/scripts/vercel-ignore.sh
!/scripts/db-sync-from-staging.mjs
!/scripts/lib/
!/scripts/db-reset.mjs
!/scripts/check-palette.mjs
!/scripts/check-ds.mjs
# CAM-537 — the WCAG token-contrast guard; must be tracked so CI can run it
!/scripts/check-contrast.mjs
# CAM-552 — the responsive-scale guard; imported by check-ds.mjs, so CI fails
# with a module-not-found if this is left untracked
!/scripts/check-scale.mjs
!/scripts/load-mock-staging.mjs
!/scripts/reconcile-ratings.mjs
!/scripts/import-linear.mjs
!/scripts/parity-check.mjs
# CAM-502 — build-step script for the committed prisma/data/province-centroids.json
!/scripts/build-province-centroids.mjs
# CAM-503 — validator for the committed, curated prisma/data/landmark-gazetteer.json
!/scripts/validate-landmark-gazetteer.mjs
# validator for the committed, curated prisma/data/place-aliases.json (Thai place nicknames)
!/scripts/validate-place-aliases.mjs
# CAM demand-seeding toolkit — tracked so Stage 0/1 are reproducible + reviewable
!/scripts/gen-mock-data.mjs
# CAM-508 — AI Chat Capability Loop: the log-pull triage script (SORT step, /ai-chat-improve)
!/scripts/ai-triage/
!/scripts/merge-mock-data.mjs
!/scripts/seed-demand.mjs
!/scripts/gen-review-text.mjs
!/scripts/ai-eval/
# CAM-536 — accommodation-code-collision backfill (TENT->TSIT / HORS->HCMP)
!/scripts/backfill-cam-536-accommodation-codes.mjs
# CAM-538 — drops the HCMP (horse-camp) AccommodationTypeEnum member entirely
!/scripts/backfill-cam-538-drop-horse-camp.mjs
# CAM-563 — backfills Location.adminAreaId from the free-text province/district/subDistrict columns
!/scripts/backfill-cam-563-location-admin-area.mjs
# CAM-562 — reverse-geocodes Location.lat/lon to fill district/subDistrict + deepen adminAreaId
!/scripts/backfill-cam-562-subdistrict-geocode.mjs
# CAM-571 — moves Location coordinates geocoding outside Thailand inside their claimed province
!/scripts/backfill-cam-571-coordinates-inside-thailand.mjs
# CAM-575 — reconciles the CampSite/Location coordinate columns that disagree today
!/scripts/backfill-cam-575-reconcile-coordinates.mjs
# CAM-583 — moves adjacent-province-mismatch coordinates inside their claimed province
!/scripts/backfill-cam-583-align-provinces.mjs
# CAM-583 — assigns DISP to verified type-less (open-field) camps
!/scripts/backfill-cam-583-assign-accommodation-type.mjs
# CAM-578 — one-command local setup (migrate deploy + seed) for the e2e-regression harness's DB
!/scripts/setup-e2e-db.ts
# CAM-579 — per-worktree Prisma client isolation setup + the loud freshness guard
!/scripts/worktree-setup.sh
!/scripts/verify-prisma-client-fresh.mjs
# CAM-600 — regenerates the committed, curated prisma/data/subdistrict-shortlist.json
!/scripts/generate-subdistrict-shortlist.mjs
# CAM-605 — detects drift between the committed shortlist above and live data
!/scripts/check-subdistrict-shortlist-drift.mjs
# CAM-588 — dev-only wrapper that warns when a running `next dev` server's
# already-loaded Prisma client goes stale relative to the schema/migrations
!/scripts/dev-with-prisma-watch.mjs
.claude/linear-snapshot.json

# local design source (large binaries; runtime copies live in public/status-map/)
/design/
# local font working dir (not wired; app uses next/font/google)
/public/fonts/

# AI triage exports (contain user chat text — PDPA, never commit)
scratch/
