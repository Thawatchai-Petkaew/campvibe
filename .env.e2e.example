# CAM-578 — template for the e2e-regression harness's LOCAL-ONLY env.
#
# Copy this file to `.env.e2e` (gitignored — never commit the copy) and fill
# in your own local Postgres user. `.env.e2e` is read by:
#   - `npm run e2e:db:setup` (scripts/setup-e2e-db.ts) — migrates + seeds it
#   - `playwright.config.ts` when PW_REGRESSION=1 — feeds the dev server +
#     the regression-setup project's DB guard (e2e/regression/db-guard.ts)
#
# Non-negotiable (BR-1, e2e/regression/db-guard.ts): DATABASE_URL's host MUST
# be localhost / 127.0.0.1 / ::1. This is a DEDICATED database, separate from
# the `campvibe` DB your own `npm run dev` points at — the regression suite
# creates/deletes real rows and must never touch the DB you use for other
# local work. See e2e/regression/README.md for the full setup walkthrough.

DATABASE_URL="postgresql://<your-local-user>@localhost:5432/campvibe_e2e?schema=public"

# Any local-only value — never a real production/staging secret.
AUTH_SECRET="local-e2e-secret-change-me"

# Must match the port the regression project serves on (E2E_PORT, default 3100).
NEXTAUTH_URL="http://localhost:3100"

# NextAuth v5 rejects a plain localhost host with no reverse proxy otherwise.
AUTH_TRUST_HOST="true"
