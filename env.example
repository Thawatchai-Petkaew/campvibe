# NextAuth / Auth.js
# Generate a strong secret: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-strong-secret"

# Google OAuth (ADR-008 — optional; provider activates only when both are set)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI to register: https://<your-domain>/api/auth/callback/google
# NEVER prefix these with NEXT_PUBLIC_ — they are server-side secrets only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database (PostgreSQL)
# Example (local):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/campvibe?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Optional: Vercel Blob Storage (if using uploads)
BLOB_READ_WRITE_TOKEN=""

# --- Public live status dashboard (/status) ---
# Linear personal API key (Settings > Security & access > Personal API keys) — server-side only
LINEAR_API_KEY=
# Token to protect /status (visit /status?token=...)
STATUS_TOKEN=
# (optional) Linear team key, default CAM
LINEAR_TEAM_KEY=CAM

# --- AI assistant tool layer (CAM-270) ---
# OpenRouter API key — server-side only, never NEXT_PUBLIC_*. When unset the
# client self-skips (no network call, no spend) — safe to leave blank in dev/CI.
# Vercel scope note: the staging branch deploys as PREVIEW-class — the var must
# have the Preview environment checked (Production-only is invisible to staging),
# and env changes only apply to deployments created AFTER the change.
OPENROUTER_API_KEY=
# Model id used for the primary call. Default when unset: openai/gpt-4o-mini
OPENROUTER_MODEL=
# One-time fallback model, tried once if the primary call fails/non-2xx/times out.
# Default when unset: openai/gpt-4o-mini
OPENROUTER_MODEL_FALLBACK=

# --- AI chat retention cron (CAM-422, ADR-013 S8) ---
# Shared secret for GET /api/cron/ai-chat-retention. Vercel Cron sends this
# automatically as `Authorization: Bearer $CRON_SECRET` once the var is set
# on the project (Vercel docs — Securing Cron Jobs). Unset = the route
# always 401s (default-deny, never falls open). Generate with:
# `openssl rand -base64 32`
CRON_SECRET=

# --- AI chat AssistantTurnLog (CAM-509, S2/SEE pillar) ---
# Salt mixed into sha256(userId + SALT) so AssistantTurnLog.userIdHash is
# never reversible back to the raw user id (PDPA, BR-4). Any random string;
# rotate on leak. Never a real value here. Generate with:
# `openssl rand -base64 32`
AI_TURN_LOG_SALT=

# --- Email (Resend) — CAM-71/CAM-685 ---
# Server-side only, never NEXT_PUBLIC_*. Transport switch: with no key,
# lib/email/client.ts logs `email_skipped` and skips the network call (safe
# no-op in dev/CI/preview).
RESEND_API_KEY=
# Sender address, e.g. "CampVibe <noreply@campvibe.app>". Falls back to that
# same default (lib/email/client.ts) when unset.
EMAIL_FROM=
# Route-level switch for host booking-alert emails (CAM-685), independent of
# RESEND_API_KEY — the day CAM-62 turns the transport key on for camper
# confirmation emails, host emails must NOT start firing silently as a side
# effect. Default off (unset/anything but "true" = off). Read at call time by
# lib/notifications/host-email.ts, not captured at module load.
EMAIL_HOST_NOTIFICATIONS=
# Base origin deep links in OUTBOUND email (lib/email/templates.ts) resolve
# against — same existing convention as app/layout.tsx / lib/notify-messages.ts.
# Falls back to the real staging origin when unset.
APP_BASE_URL=
